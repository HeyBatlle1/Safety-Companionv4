# Safety Companion — environment template.
# Copy to .env and fill in. NEVER commit .env (it is gitignored; only this
# .env.example is tracked).

# ── Database (Supabase Postgres) ───────────────────────────────────────────
# Paste whichever connection string you have. All three forms work — the
# engine disables statement caching so it behaves identically behind the
# transaction-mode pooler, session mode, or a direct connection.
#
#   Transaction pooler (recommended for serverless / most deploys), port 6543:
#     postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Session pooler, port 5432:
#     postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Direct connection:
#     postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#
# Leaving DATABASE_URL unset is allowed: the server runs stateless (analyses
# work but are not remembered). The migrator (`scd --migrate`) REQUIRES it.
DATABASE_URL=

# ── Model provider (OpenRouter) ────────────────────────────────────────────
OPENROUTER_API_KEY=

# Per-role model chains (comma-separated fallbacks). Optional — sensible
# defaults apply if unset. Provider-agnostic: no single vendor is load-bearing.
# SC_MODEL_VALIDATOR=
# SC_MODEL_ASSESSOR=
# SC_MODEL_PREDICTOR=

# ── Server ─────────────────────────────────────────────────────────────────
# Bind address for the scd HTTP daemon (default 0.0.0.0:8787).
# SC_BIND=0.0.0.0:8787

# Dedicated random secret for session signing — NOT derived from any API key.
# Generate: openssl rand -hex 32
SC_SESSION_KEY=
